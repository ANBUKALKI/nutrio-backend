{
  "name": "nutrio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API shared by the Nutrio web (React) and mobile (Flutter) apps.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "start:memory": "node src/server.js --memory",
    "test": "node --test",
    "seed:demo": "node src/seed-cli.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5"
  }
}
